# ==========================================
# BUDDHI - Environment Variables Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL + Prisma)
# Default points to the zero-config local user-space PostgreSQL started on port 5433
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/buddhi_db?schema=public"

# JWT Authentication Secret
JWT_SECRET="buddhi_super_secret_jwt_key_hackathon_2026_wemakedevs"
JWT_EXPIRES_IN="7d"

# AI Provider Configuration (Optional - Intelligent Demo Fallback included if unset)
# Choose your preferred provider: "gemini" | "openai" | "anthropic" | "demo"
AI_PROVIDER="demo"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Switch Integration Configuration
SWITCH_WEBHOOK_SECRET="buddhi_switch_secret_token_2026"
SWITCH_AGENT_NAME="Buddhi Study Agent"
SWITCH_ROOM_NAME="buddhi-study-room"
MATTERMOST_WEBHOOK_URL="http://localhost:8065/hooks/sample-mattermost-hook"
